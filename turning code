// Motor Pin Definitions (based on Nathan's wiring)
const int enA = 11;  // PWM enable pin for motor A
const int in1 = 8;   // Direction control pin 1 for motor A
const int in2 = 9;   // Direction control pin 2 for motor A
const int enB = 10;  // PWM enable pin for motor B
const int in3 = 12;  // Direction control pin 1 for motor B
const int in4 = 13;  // Direction control pin 2 for motor B

// Movement parameters (already adjusted to our car)
float wheelDiameter = 0.0675;  // Diameter of the wheels (meters)
float wheelBase = 0.19685;      // Distance between the two wheels (front and back) (meters)

// Function to setup motors and pins
void setup() {
  // Set motor controller pins as OUTPUT
  pinMode(enA, OUTPUT);
  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);
  pinMode(in3, OUTPUT);
  pinMode(in4, OUTPUT);
  pinMode(enB, OUTPUT);

  // Start motors with PWM (currently set at 1/2 speed..1/4 speed would be around 64)
  
  analogWrite(enA, 150);  // Half speed for motor A
  analogWrite(enB, 150);  // Half speed for motor B
}

// Function to stop motors
// This function stops the motors. You don't need to change anything here unless you want to stop the motors differently (e.g., by reversing the direction).

void stopMotors() {
  digitalWrite(in1, LOW);
  digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);
  digitalWrite(in4, LOW);

  // Optionally, set the enable pins to 0 to stop motors
  analogWrite(enA, 0);
  analogWrite(enB, 0);
}

// Function to move the robot forward for a given distance (in meters)
void moveForward(float distance) {
  // Distance the robot moves per revolution (circumference of the wheel)
  float wheelCircumference = 3.14159 * wheelDiameter;

  // Number of wheel revolutions needed to travel the specified distance
  int revolutions = distance / wheelCircumference;

  // Motor direction and movement for forward motion
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);

  // Move forward for the calculated distance (in milliseconds)
  unsigned long startTime = millis();
  while (millis() - startTime < revolutions * 1000) { // Adjust time multiplier for correct motion
    // Keep moving forward until the time for required revolutions has passed
  }

  stopMotors();  // Stop after the movement
}

// Function to turn the robot in place for a specified angle (in degrees)
void turn(float angle) {
  // To turn the robot in place, reverse one motor's direction
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);
  digitalWrite(in4, HIGH);

  // Adjust the delay based on the turning speed of the robot
 // need to experiment with the turnDelay value to adjust the turning speed, depending on your robot's physical characteristics.

  int turnDelay = (angle / 90.0) * 1000;  // Adjust for proper turning speed
  delay(turnDelay);  // Wait for the robot to complete the turn
}

// Function to trace a circle with a given radius (in meters)
void traceCircle(float radius) {
  // Calculate the circle's circumference
  float circleCircumference = 2 * 3.14159 * radius;

  // Move forward in a circle
  moveForward(circleCircumference);

  // Turn the robot in place by 90 degrees three times (3 full rotations for a circle)
  for (int i = 0; i < 3; i++) {
    turn(90);  // Turn by 90 degrees each time
  }
}

// Function to trace a rectangle (X by Y meters)
void traceRectangle(float X, float Y) {
  // Move forward along one side (X)
  moveForward(X);

  // Turn 90 degrees to follow the next side
  turn(90);

  // Move forward along the other side (Y)
  moveForward(Y);

  // Turn 90 degrees to follow the next side
  turn(90);

  // Repeat for the remaining sides
  moveForward(X);
  turn(90);
  moveForward(Y);
  turn(90);  // Complete the rectangle loop
}

void loop() {
  // Example inputs for circle and rectangle paths
  float X = 1.0; // Example radius for circle
  float Y = 2.0; // Example length of rectangle
  float Z = 1.5; // Example width of rectangle
  
  // Circle path (3 full circles with the specified radius)
  traceCircle(X);
  
  delay(1000);  // Short delay before starting the rectangle path
  
  // Rectangle path (trace the rectangle with specified X and Y dimensions)
  traceRectangle(Y, Z);
  
  // End of loop, robot will stop here
  while (true) {
    // Do nothing, stop the robot after finishing the paths
    stopMotors();
  }
}
